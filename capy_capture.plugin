#!name=CapyPlayer 接口采集
#!desc=采集 recommend.feifeiduck.com 与 tmdb.quswer.com 的完整请求/响应，回传本机 8899 端口
#!date=1.0

[Script]
# 只拦这两个域，避免影响其它 App
http-response ^https?://(recommend\.feifeiduck\.com|tmdb\.quswer\.com)/ script-path=https://raw.githubusercontent.com/hahalocn/loon-plugins/main/capy_capture.js?v=1,requires-body=true

[Mitm]
hostname = %APPEND% recommend.feifeiduck.com, tmdb.quswer.com
