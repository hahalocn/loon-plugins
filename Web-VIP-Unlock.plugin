#!name=Web VIP 解锁
#!desc=通过 MITM 改写客户端权益字段，使 App 判定为已开通会员。仅用于自有设备的兼容性研究。
#!date=1.0

[Script]
http-response ^https?://(cupid|vapi)\.51job(app)?\.com/ script-path=https://raw.githubusercontent.com/hahalocn/loon-plugins/main/web_vip.js?v=5,requires-body=true

[MitM]
hostname = %APPEND% cupid.51job.com, cupid.51jobapp.com, vapi.51job.com
